# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET_NAME=your-bucket-name

# Server Configuration
PORT=8080
NODE_ENV=development

# Video Processing Limits
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=300

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TEMPERATURE=0.15

# YouTube Integration (optional — enables YouTube video search & import)
YOUTUBE_API_KEY=your-youtube-api-key

# ML Analysis (optional — YOLOv8 + SigLIP player detection & team clustering)
ML_ANALYSIS_FPS=2
ML_ENABLED=true

# Firestore (uses ADC + GOOGLE_CLOUD_PROJECT — no extra config needed)
# Run ./setup-firestore.sh to create the database and grant IAM roles
